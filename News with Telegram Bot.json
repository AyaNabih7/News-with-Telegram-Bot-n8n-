        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "def strip_brackets(s, marker):\n    out = []\n    i = 0\n    while i < len(s):\n        if s[i] == '[' and s[i+1:i+1+len(marker)] == marker:\n            j = s.find(']', i)\n            if j != -1:\n                i = j + 1\n                while out and out[-1] in ' \\t':\n                    out.pop()\n                continue\n        out.append(s[i])\n        i += 1\n    return ''.join(out)\n\n\ndef md_links(s):\n    out = []\n    i = 0\n    while i < len(s):\n        if s[i] == '[':\n            close = s.find(']', i)\n            if close != -1 and close + 1 < len(s) and s[close+1] == '(':\n                end = s.find(')', close)\n                if end != -1:\n                    out.append(s[i+1:close])\n                    i = end + 1\n                    continue\n        out.append(s[i])\n        i += 1\n    return ''.join(out)\n\n\nt = _item[\"json\"].get(\"content\") or \"\"\n\nt = strip_brackets(t, '?q=')\nt = strip_brackets(t, 'http')\nt = md_links(t)\n\nwhile '  ' in t:\n    t = t.replace('  ', ' ')\nwhile '\\n\\n\\n' in t:\n    t = t.replace('\\n\\n\\n', '\\n\\n')\n\nt = t.strip()\n\nt = t.replace('&', '&amp;')\nt = t.replace('<', '&lt;')\nt = t.replace('>', '&gt;')\n\n_item[\"json\"][\"content\"] = t\n\nreturn _item"
